# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment variables
# Copy to .env.local and fill in values. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (used by the app and by the CSP connect-src allowlist).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Stellar network: testnet | mainnet | futurenet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Horizon endpoint for the selected network.
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint for the selected network.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ─────────────────────────────────────────────────────────────────────────────
# CSP connect-src allowlist (issue #1814)
#
# Comma-separated list of extra origins the browser may connect to via
# fetch/XHR/WebSocket. These are appended to the built-in allowlist that
# already covers NEXT_PUBLIC_API_URL, NEXT_PUBLIC_HORIZON_URL and
# NEXT_PUBLIC_SOROBAN_RPC_URL.
#
# Rules:
#   - Use full origins only (scheme + host + optional port), e.g.
#     https://api.staging.example.com
#   - Wildcards (*) are rejected in production builds.
#   - Wallet extension origins (e.g. Freighter) are injected automatically
#     by the CSP builder; do not list them here.
#
# Staging example (extra APIs beyond the defaults):
# NEXT_PUBLIC_CSP_CONNECT_SRC_EXTRA=https://api.staging.example.com,https://horizon.staging.example.com
NEXT_PUBLIC_CSP_CONNECT_SRC_EXTRA=

# Optional CSP report endpoint. When set, a report-uri directive is added so
# violations are collected without weakening enforcement.
# NEXT_PUBLIC_CSP_REPORT_URI=https://csp-report.example.com/report
NEXT_PUBLIC_CSP_REPORT_URI=

# WalletConnect relay (only used when the WalletConnect flag is enabled).
# When NEXT_PUBLIC_ENABLE_WALLETCONNECT=true the relay origin is added to the
# CSP connect-src allowlist automatically.
NEXT_PUBLIC_ENABLE_WALLETCONNECT=false
NEXT_PUBLIC_WALLETCONNECT_RELAY_URL=wss://relay.walletconnect.com
