# ---------------------------------------------------------------------------
# Backend environment configuration (example)
# Copy to `.env` and adjust per environment. Never commit real secrets.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated allowlist of browser origins permitted to call the API.
# - Use explicit origins (scheme + host + optional port). No trailing slash.
# - Staging / preview deploys: append their origins here (comma-separated).
# - Do NOT use "*" together with CORS_CREDENTIALS=true in production; the
#   application will refuse to boot in that combination.
# - When CORS_ORIGINS is empty, no cross-origin browser requests are allowed.
#
# Example (development):
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
#
# Example (staging, includes preview deploy URL):
# CORS_ORIGINS=https://staging.example.com,https://app-preview-123.example.com
#
# Example (production, explicit allowlist only):
# CORS_ORIGINS=https://app.example.com

# Whether to send Access-Control-Allow-Credentials. Requires an explicit
# CORS_ORIGINS allowlist in production (wildcard is rejected at boot).
CORS_CREDENTIALS=true

# ---------------------------------------------------------------------------
# Security headers (Helmet)
# ---------------------------------------------------------------------------
# Helmet is enabled by default with sensible defaults. Set to "false" only
# for local debugging; production should keep this enabled.
HELMET_ENABLED=true

# Content-Security-Policy connect-src hosts, comma-separated. Must include the
# API origin(s) the frontend SPA (Freighter) calls. See
# frontend/docs/SECURITY_HEADERS.md for the frontend expectations.
# Example:
# CSP_CONNECT_SRC=https://api.example.com,https://app.example.com
