# Application
PORT=3000
NODE_ENV=development

# Body size limits (bytes)
# Maximum size for JSON and urlencoded request bodies. Requests exceeding this
# limit are rejected with HTTP 413 before auth-heavy parsers run.
MAX_JSON_BODY_BYTES=1048576

# Maximum size for multipart uploads to /content/upload. Kept separate from and
# larger than MAX_JSON_BODY_BYTES. Requests exceeding this limit are rejected
# with HTTP 413.
MAX_MULTIPART_BODY_BYTES=52428800
