[TEMPLATE]
# Generated by contract/scripts/deploy.sh — variable reference: contract/docs/DEPLOYED_ENV.md
#
# This is a TEMPLATE showing the shape deploy.sh writes to contract/.env.deployed*
# after a real deployment. Replace the placeholder IDs below with the actual
# contract IDs your .env.deployed-<network> file contains (or run a deploy to
# generate a real one). Never commit a real .env.deployed* file — it records
# deployer account info and is gitignored.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_SOURCE_ACCOUNT=<DEPLOYER_PUBLIC_KEY>

# Canonical contract IDs (preferred for backend / new .env)
CONTRACT_ID_MYFANS_TOKEN=<MYFANS_TOKEN_ID>
CONTRACT_ID_CREATOR_REGISTRY=<CREATOR_REGISTRY_ID>
CONTRACT_ID_SUBSCRIPTION=<SUBSCRIPTION_ID>
CONTRACT_ID_CONTENT_ACCESS=<CONTENT_ACCESS_ID>
CONTRACT_ID_EARNINGS=<EARNINGS_ID>

# Aliases — same values; kept for backward compatibility with existing tooling
TOKEN_CONTRACT_ID=<MYFANS_TOKEN_ID>
CREATOR_REGISTRY_CONTRACT_ID=<CREATOR_REGISTRY_ID>
SUBSCRIPTIONS_CONTRACT_ID=<SUBSCRIPTION_ID>
SUBSCRIPTION_CONTRACT_ID=<SUBSCRIPTION_ID>
CONTRACT_ID_SUBSCRIPTIONS=<SUBSCRIPTION_ID>
CONTENT_ACCESS_CONTRACT_ID=<CONTENT_ACCESS_ID>
EARNINGS_CONTRACT_ID=<EARNINGS_ID>

# --- Frontend (Next.js) copy these into frontend/.env.local ------------------
# NEXT_PUBLIC_SUBSCRIPTION_CONTRACT_ID=<SUBSCRIPTION_ID>
# NEXT_PUBLIC_MYFANS_TOKEN_CONTRACT_ID=<MYFANS_TOKEN_ID>
# NEXT_PUBLIC_CREATOR_REGISTRY_CONTRACT_ID=<CREATOR_REGISTRY_ID>
# NEXT_PUBLIC_CONTENT_ACCESS_CONTRACT_ID=<CONTENT_ACCESS_ID>
# NEXT_PUBLIC_EARNINGS_CONTRACT_ID=<EARNINGS_ID>
# NEXT_PUBLIC_STELLAR_NETWORK=testnet