{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Shared test vectors for MyFans Soroban contract call arguments. Used by both the TypeScript Vitest suite (frontend/src/lib/__tests__/contract-test-vectors.test.ts) and the Rust cargo test suite (contract/contracts/*/src/test_vectors.rs). Update this file and regenerate when contract arg types or order change.",
  "version": "1",
  "network": {
    "testnet": {
      "passphrase": "Test SDF Network ; September 2015",
      "rpc_url": "https://rpc-testnet.stellar.org:443"
    },
    "futurenet": {
      "passphrase": "Test SDF Future Network ; October 2022",
      "rpc_url": "https://rpc-futurenet.stellar.org:443"
    },
    "mainnet": {
      "passphrase": "Public Global Stellar Network ; September 2015",
      "rpc_url": "https://rpc-mainnet.stellar.org:443"
    }
  },
  "default_network": "testnet",
  "vectors": [
    {
      "id": "create_plan_basic",
      "description": "create_plan with a standard USDC-like token and 30-day interval",
      "method": "create_plan",
      "network": "testnet",
      "args": {
        "creator": "GCEZWKCA5VLDNRLN3RPRJMRZOX3Z6G5CHCGOO6LCVWQLDQKQ36F4H4Y",
        "token": "GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5",
        "amount_atomic": "10000000",
        "interval_days": 30
      },
      "arg_types": {
        "creator": "Address",
        "token": "Address",
        "amount_atomic": "i128",
        "interval_days": "u32"
      },
      "arg_order": ["creator", "token", "amount_atomic", "interval_days"],
      "expected_op_name": "create_plan",
      "notes": "amount_atomic is in stroops/base-units (10000000 = 1.0 USDC at 7 decimals)"
    },
    {
      "id": "create_plan_xlm",
      "description": "create_plan denominated in native XLM",
      "method": "create_plan",
      "network": "testnet",
      "args": {
        "creator": "GCEZWKCA5VLDNRLN3RPRJMRZOX3Z6G5CHCGOO6LCVWQLDQKQ36F4H4Y",
        "token": "CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC",
        "amount_atomic": "50000000",
        "interval_days": 30
      },
      "arg_types": {
        "creator": "Address",
        "token": "Address",
        "amount_atomic": "i128",
        "interval_days": "u32"
      },
      "arg_order": ["creator", "token", "amount_atomic", "interval_days"],
      "expected_op_name": "create_plan",
      "notes": "50000000 stroops = 5 XLM at 7 decimals"
    },
    {
      "id": "subscribe_basic",
      "description": "subscribe fan to a creator plan (plan_id=1)",
      "method": "subscribe",
      "network": "testnet",
      "args": {
        "fan": "GAAZI4TCR3TY5OJHCTJC2A4QSY6CJWJH5IAJTGKIN2ER7LBNVKOCCWN",
        "creator": "GCEZWKCA5VLDNRLN3RPRJMRZOX3Z6G5CHCGOO6LCVWQLDQKQ36F4H4Y",
        "plan_id": 1,
        "token": "GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5"
      },
      "arg_types": {
        "fan": "Address",
        "creator": "Address",
        "plan_id": "u32",
        "token": "Address"
      },
      "arg_order": ["fan", "creator", "plan_id", "token"],
      "expected_op_name": "subscribe",
      "notes": "fan signs this transaction; token must match the plan's configured token"
    },
    {
      "id": "subscribe_plan_zero",
      "description": "subscribe to plan_id=0 (edge case — first plan ever created)",
      "method": "subscribe",
      "network": "testnet",
      "args": {
        "fan": "GAAZI4TCR3TY5OJHCTJC2A4QSY6CJWJH5IAJTGKIN2ER7LBNVKOCCWN",
        "creator": "GCEZWKCA5VLDNRLN3RPRJMRZOX3Z6G5CHCGOO6LCVWQLDQKQ36F4H4Y",
        "plan_id": 0,
        "token": "GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5"
      },
      "arg_types": {
        "fan": "Address",
        "creator": "Address",
        "plan_id": "u32",
        "token": "Address"
      },
      "arg_order": ["fan", "creator", "plan_id", "token"],
      "expected_op_name": "subscribe"
    },
    {
      "id": "cancel_basic",
      "description": "cancel subscription with default reason (0 = user-initiated)",
      "method": "cancel",
      "network": "testnet",
      "args": {
        "fan": "GAAZI4TCR3TY5OJHCTJC2A4QSY6CJWJH5IAJTGKIN2ER7LBNVKOCCWN",
        "creator": "GCEZWKCA5VLDNRLN3RPRJMRZOX3Z6G5CHCGOO6LCVWQLDQKQ36F4H4Y",
        "reason": 0
      },
      "arg_types": {
        "fan": "Address",
        "creator": "Address",
        "reason": "u32"
      },
      "arg_order": ["fan", "creator", "reason"],
      "expected_op_name": "cancel",
      "notes": "reason codes: 0=user-initiated, 1=too expensive, 2=content quality, 3=switching creator, 4=other"
    },
    {
      "id": "cancel_reason_too_expensive",
      "description": "cancel with reason=1 (too expensive)",
      "method": "cancel",
      "network": "testnet",
      "args": {
        "fan": "GAAZI4TCR3TY5OJHCTJC2A4QSY6CJWJH5IAJTGKIN2ER7LBNVKOCCWN",
        "creator": "GCEZWKCA5VLDNRLN3RPRJMRZOX3Z6G5CHCGOO6LCVWQLDQKQ36F4H4Y",
        "reason": 1
      },
      "arg_types": {
        "fan": "Address",
        "creator": "Address",
        "reason": "u32"
      },
      "arg_order": ["fan", "creator", "reason"],
      "expected_op_name": "cancel"
    }
  ]
}
