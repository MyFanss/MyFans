# Dependencies
node_modules/

# Contract (Rust / Soroban)
contract/target/
# Deploy outputs + identity state — must never be committed. Generated by
# contract/scripts/deploy.sh (contract/deployed*.json, contract/.env.deployed*).
# These contain deployer account info / Soroban RPC credentials the secrets
# policy requires to stay out of version control; record IDs into .env manually.
contract/deployed*.json
contract/deployed-local.json
contract/deployed-*.json
contract/.env.deployed*
contract/.stellar/

# Environment
.env
.env.*
!.env.example
!.env.dev.example
# Deploy output template is safe to track; real deploy outputs are ignored above.
!contract/.env.deployed.example
.env.dev

# OS
.DS_Store
Thumbs.db

